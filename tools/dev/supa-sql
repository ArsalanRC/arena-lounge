#!/bin/sh
# Run one SQL file on the personal arena-lounge project through the Supabase Management API
# (needs only the personal access token, no database password).   tools/dev/supa-sql supabase/003_signed_reports.sql
TOKEN_FILE="$HOME/.config/arena-lounge/supabase-token"
[ -r "$TOKEN_FILE" ] || { echo "missing $TOKEN_FILE (see docs/LEADERBOARD-SETUP.md)" >&2; exit 1; }
[ -r "$1" ] || { echo "usage: tools/dev/supa-sql <file.sql>" >&2; exit 1; }
python3 - "$1" "$TOKEN_FILE" <<'PY'
import json, sys, urllib.request
sql = open(sys.argv[1]).read()
token = open(sys.argv[2]).read().strip()
req = urllib.request.Request(
    "https://api.supabase.com/v1/projects/vpizpihqwkmxtidqduos/database/query",
    data=json.dumps({"query": sql}).encode(), method="POST",
    headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "arena-lounge-tools/1.0"})
try:
    with urllib.request.urlopen(req) as r:
        print(r.status, r.read().decode()[:2000])
except urllib.error.HTTPError as e:
    print(e.code, e.read().decode()[:2000]); sys.exit(1)
PY
